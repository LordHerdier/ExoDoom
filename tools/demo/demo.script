# The client demo (SCRUM-121), as docs/demo.md runs it, for tools/demo/qmp_drive.py.
# Beat numbers match docs/demo.md. Waits are generous for TCG; a live
# presenter replaces them with narration.

# Beat 1 -- new install: blank disk, format it live
wait 8
shot 01-first-boot
type y
wait 3
type programs
shot 01-formatted

# Beats 2-3 -- install Doom and Snake from the install disk
type clear
type install
shot 02-install-disk
type clear
type install doom
wait 6
type install freedoom2.wad
wait 30
type install snake
wait 3
shot 03-installed
# Not narrated: what the later beats run
type install voldemoa
type install voldemob
type install top
wait 3
type clear
type programs
shot 03-programs

# Beats 4-5 -- specs and the resource grant (serial), then run it
type run snake.exo
wait 3
shot 05-snake
key q
wait 3

# Beat 6 -- two programs, two filesystems, one disk
type run voldemoa.exo
wait 5
shot 06-volume-a
key q
wait 2
type run voldemob.exo
wait 5
shot 06-volume-b
key q
wait 2
type run voldemoa.exo
wait 5
shot 06-volume-a-again
key q
wait 2

# Beat 7 -- the dashboard, started BEFORE Doom (see docs/demo.md, "Order")
type run top.exo
wait 4
shot 07-top
key ctrl-tab
wait 2
type run doom.exo
wait 25
shot 07-doom
key ctrl-tab
wait 3
key ctrl-tab
wait 3
shot 07-top-with-doom

# What the serial log must show
expect ^granted: context
expect ^  pages  \d+ \(asked min \d+, rec \d+\)
expect voldemo\[A\] formatted new volume
expect voldemo\[B\] formatted new volume
expect voldemo\[A\] launches=2
expect voldemo\[B\] probe volumeA .* refused
expect voldemo\[A\] probe whole-disk .* refused
expect DG_Init: WAD found
expect-not GRANTED -- isolation broken
expect-not PAGE FAULT
expect-not FATAL
