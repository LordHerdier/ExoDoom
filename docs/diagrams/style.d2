# Shared look for every ExoDoom diagram. Imported with `...@style` inside
# `classes` is not possible, so each diagram does `...@style` at top level.
#
# One colour per layer, used the same way in all seven diagrams:
#   hw    hardware                 slate
#   k     ring 0 (kernel)          indigo
#   u     ring 3 (LibOS programs)  teal
#   doom  Doom engine + platform   amber
#   gate  the syscall / interrupt boundary, dark
#   warn  a rule or check that refuses something, red
classes: {
  hw: {
    style: {
      fill: "#EDF1F6"
      stroke: "#5B6B7F"
      font-color: "#1F2A37"
      border-radius: 6
      stroke-width: 1
    }
  }
  k: {
    style: {
      fill: "#E9EAFB"
      stroke: "#4F46E5"
      font-color: "#1E1B4B"
      border-radius: 6
      stroke-width: 1
    }
  }
  u: {
    style: {
      fill: "#E1F4F0"
      stroke: "#0F8B7A"
      font-color: "#063B33"
      border-radius: 6
      stroke-width: 1
    }
  }
  doom: {
    style: {
      fill: "#FDEBD3"
      stroke: "#D9822B"
      font-color: "#4A2A05"
      border-radius: 6
      stroke-width: 1
    }
  }
  gate: {
    style: {
      fill: "#1F2937"
      stroke: "#111827"
      font-color: "#FFFFFF"
      border-radius: 6
      bold: true
    }
  }
  warn: {
    style: {
      fill: "#FDECEC"
      stroke: "#C62828"
      font-color: "#5B1111"
      border-radius: 6
      stroke-width: 1
    }
  }
  zone: {
    style: {
      fill: "#FFFFFF"
      stroke-dash: 3
      border-radius: 10
      font-size: 20
      bold: true
    }
  }
  note: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#4B5563"
      font-size: 13
      italic: true
    }
  }
  flow: {
    style: {
      stroke: "#374151"
      stroke-width: 2
      font-size: 13
      font-color: "#374151"
    }
  }
}
